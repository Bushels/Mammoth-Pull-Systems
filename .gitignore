# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
.dev-server.log
.dev-server.err.log

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# local tooling artifacts
.playwright-cli/
.playwright-mcp/
# .claude/ holds Claude Code project-local config. Track agents/ and skills/
# (project-specific routing/personas), but ignore runtime files like
# scheduled_tasks.lock and settings.local.json.
.claude/*
!.claude/agents/
!.claude/agents/**
!.claude/skills/
!.claude/skills/**
.claude/settings.local.json
output/

# dev-only screenshot / snapshot artifacts at repo root
/*.png
/*.yml

# source media dump kept locally; curated site assets live in /public/media
Images_Videos/

# typescript
*.tsbuildinfo
next-env.d.ts
